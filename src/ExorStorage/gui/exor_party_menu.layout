PanelWidgetClass ExorPartyRoot
{
	visible 1
	position 0 0
	size 1 1
	color 0 0 0 0.6
	style rover_sim_colorable
	hexactpos 0
	vexactpos 0
	hexactsize 0
	vexactsize 0
	{
		PanelWidgetClass ExorPartyPanel
		{
			visible 1
			position 0.33 0.13
			size 0.34 0.74
			color 0.06 0.07 0.12 1
			style rover_sim_colorable
			halign left_ref
			valign top_ref
			hexactpos 0
			vexactpos 0
			hexactsize 0
			vexactsize 0
			{
				TextWidgetClass ExorPartyTitle
				{
					visible 1
					position 0.02 0.02 size 0.96 0.07
					hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
					color 1 1 1 1
					text "PARTY"
					font "gui/fonts/Metron-Bold58"
					"exact text" 1
					"exact text size" 26
					"text halign" center
					"text valign" center
				}
				TextWidgetClass ExorPartySub
				{
					visible 1
					position 0.05 0.10 size 0.9 0.04
					hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
					color 0.7 0.7 0.7 1
					text "Toca un miembro para expulsarlo"
					font "gui/fonts/MetronBook16"
					"exact text" 1
					"exact text size" 14
					"text halign" center
				}
				ScrollWidgetClass ExorPartyScroll
				{
					visible 1
					position 0.05 0.16 size 0.9 0.63
					color 0 0 0 0
					hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
					"Scrollbar V" 1
					{
						WrapSpacerWidgetClass ExorPartyList
						{
							position 0 0 size 1 30
							hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 1
							"Size To Content V" 1
						}
					}
				}
				ButtonWidgetClass ExorPartyBtnLeave
				{
					visible 1 position 0.05 0.83 size 0.9 0.07 color 0.4 0.2 0.1 1
					style rover_sim_colorable text "Salir del party" font "gui/fonts/MetronBook16"
				}
				ButtonWidgetClass ExorPartyBtnClose
				{
					visible 1 position 0.05 0.92 size 0.9 0.06 color 0.2 0.2 0.28 1
					style rover_sim_colorable text "Cerrar" font "gui/fonts/MetronBook16"
				}

				PanelWidgetClass ExorPartyConfirm
				{
					visible 0
					position 0.05 0.35 size 0.9 0.3
					color 0.1 0.1 0.16 1
					style rover_sim_colorable
					hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
					{
						TextWidgetClass ExorPartyConfirmText
						{
							visible 1 position 0.05 0.1 size 0.9 0.4
							hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
							color 1 1 1 1 text "Expulsar?"
							font "gui/fonts/MetronBook16"
							"exact text" 1 "exact text size" 18
							"text halign" center "text valign" center
							wrap 1
						}
						ButtonWidgetClass ExorPartyBtnYes
						{
							visible 1 position 0.08 0.6 size 0.4 0.3 color 0.45 0.15 0.15 1
							style rover_sim_colorable text "Si, expulsar" font "gui/fonts/MetronBook16"
						}
						ButtonWidgetClass ExorPartyBtnNo
						{
							visible 1 position 0.52 0.6 size 0.4 0.3 color 0.12 0.4 0.12 1
							style rover_sim_colorable text "No" font "gui/fonts/MetronBook16"
						}
					}
				}
			}
		}
	}
}
