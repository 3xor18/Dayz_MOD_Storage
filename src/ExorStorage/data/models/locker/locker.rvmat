// Material del LOCKER de equipo - shader Super.
// El diffuse (_co) se asigna como textura base en el LOD visual (Object Builder);
// aca van el normal (_nohq) y el specular (_smdi).
ambient[] = {1.0, 1.0, 1.0, 1.0};
diffuse[] = {1.0, 1.0, 1.0, 1.0};
forcedDiffuse[] = {0.0, 0.0, 0.0, 0.0};
emmisive[] = {0.0, 0.0, 0.0, 1.0};
specular[] = {0.35, 0.35, 0.35, 1.0};
specularPower = 60;
PixelShaderID = "Super";
VertexShaderID = "Super";

class Stage1
{
	texture = "ExorStorage\data\models\locker\locker_nohq.paa";
	uvSource = "tex";
	class uvTransform
	{
		aside[] = {1.0, 0.0, 0.0};
		up[]    = {0.0, 1.0, 0.0};
		dir[]   = {0.0, 0.0, 0.0};
		pos[]   = {0.0, 0.0, 0.0};
	};
};

class Stage2
{
	texture = "ExorStorage\data\models\locker\locker_smdi.paa";
	uvSource = "tex";
	class uvTransform
	{
		aside[] = {1.0, 0.0, 0.0};
		up[]    = {0.0, 1.0, 0.0};
		dir[]   = {0.0, 0.0, 0.0};
		pos[]   = {0.0, 0.0, 0.0};
	};
};
